# Build output
build/
out/
install/
compile_commands.json
.cache/

# Release staging. scripts/package-release.sh assembles here; the archives it
# makes are attached to a GitHub Release, never committed - they carry the whole
# Qt, VTK and GDAL runtime and run to tens of megabytes.
dist/
html/

# Machine-local build configuration (vcpkg root, compiler paths).
# CMakePresets.json is committed; CMakeUserPresets.json never is.
CMakeUserPresets.json

# Editors
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
CMakeLists.txt.user*
*.pro.user*
.idea/
.DS_Store

# vcpkg manifest-mode working directories
vcpkg_installed/

# Python bytecode. The scripts in scripts/ are run in place, so their caches
# land next to the sources.
__pycache__/
*.pyc

# Data snapshots: fetch scripts and content hashes are committed, payloads are not.
data/snapshots/

# Secrets. Never committed; the ai/ module reads its key from the environment.
.env
*.key
