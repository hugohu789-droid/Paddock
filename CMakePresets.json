{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default (Debug, core + tests)",
      "description": "Everyday development preset. Used by the CLI, VS Code and Qt Creator alike.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ci-core",
      "inherits": "base",
      "displayName": "CI: core-only, three platforms",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PADDOCK_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "gui",
      "inherits": "release",
      "displayName": "The Qt6 + VTK map view",
      "description": "RelWithDebInfo, because a Debug build needs a Debug VTK: mixing MSVC debug and release runtimes across the VTK boundary crashes on the first widget. See docs/setup.md.",
      "cacheVariables": {
        "PADDOCK_BUILD_GUI": "ON"
      }
    },
    {
      "name": "ci-gui",
      "inherits": "ci-core",
      "displayName": "CI: Qt6 + VTK map view (Ubuntu 26.04)",
      "cacheVariables": {
        "PADDOCK_BUILD_GUI": "ON"
      }
    },
    {
      "name": "gis",
      "inherits": "default",
      "displayName": "Local: core + gis (GDAL, PROJ)",
      "description": "Adds the geospatial stack. Linux and macOS take GDAL and PROJ from the system package manager; Windows takes them from vcpkg, which is why this preset asks for the manifest feature rather than assuming they are on the machine already.",
      "cacheVariables": {
        "PADDOCK_BUILD_GIS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;gis"
      }
    },
    {
      "name": "ci-gis",
      "inherits": "ci-core",
      "displayName": "CI: core + gis, three platforms",
      "cacheVariables": {
        "PADDOCK_BUILD_GIS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;gis"
      }
    },
    {
      "name": "ci-asan",
      "inherits": "base",
      "displayName": "CI: Debug with ASan and UBSan (Linux)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PADDOCK_SANITIZE": "address;undefined"
      }
    },
    {
      "name": "ci-tidy",
      "inherits": "base",
      "displayName": "CI: compile database for clang-tidy",
      "description": "Compiler comes from CC/CXX so the toolchain major matches clang-tidy's.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci-core",
      "configurePreset": "ci-core"
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan"
    },
    {
      "name": "gui",
      "configurePreset": "gui"
    },
    {
      "name": "ci-gui",
      "configurePreset": "ci-gui"
    },
    {
      "name": "ci-tidy",
      "configurePreset": "ci-tidy"
    },
    {
      "name": "ci-gis",
      "configurePreset": "ci-gis"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 8
      }
    },
    {
      "name": "default",
      "inherits": "test-base",
      "configurePreset": "default"
    },
    {
      "name": "fast",
      "inherits": "test-base",
      "configurePreset": "default",
      "displayName": "Pre-commit subset (< 10 s)",
      "filter": {
        "include": {
          "label": "fast"
        }
      }
    },
    {
      "name": "ci-core",
      "inherits": "test-base",
      "configurePreset": "ci-core"
    },
    {
      "name": "ci-asan",
      "inherits": "test-base",
      "configurePreset": "ci-asan"
    },
    {
      "name": "ci-gis",
      "inherits": "test-base",
      "configurePreset": "ci-gis"
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        },
        {
          "type": "test",
          "name": "default"
        }
      ]
    },
    {
      "name": "ci-core",
      "steps": [
        {
          "type": "configure",
          "name": "ci-core"
        },
        {
          "type": "build",
          "name": "ci-core"
        },
        {
          "type": "test",
          "name": "ci-core"
        }
      ]
    }
  ]
}
